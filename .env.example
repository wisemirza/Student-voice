# ============================================================================
# UWE Bristol "Student Voice" - Environment Configuration (.env.example)
# ============================================================================

PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Security Secrets (REQUIRED in production)
COOKIE_SECRET=replace-with-at-least-32-random-bytes-hex-secret
ADMIN_PASSWORD=replace-with-a-strong-moderator-password

# ----------------------------------------------------------------------------
# Firebase Cloud Firestore Storage (Recommended)
# In Firebase App Hosting / Cloud Run, Application Default Credentials work
# automatically - only FIREBASE_PROJECT_ID and FIREBASE_DATABASE_ID are needed.
# Locally, set FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=studio-9101762883-d0a0e
FIREBASE_DATABASE_ID=student-voice-db
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Local SQLite / PostgreSQL Fallbacks (used only if FIREBASE_PROJECT_ID is unset)
SQLITE_DB_PATH=./data/student_voice.db
# DATABASE_URL=

# ----------------------------------------------------------------------------
# Automatic Screen-Wide Translation (English <-> Simplified Chinese)
# Defaults to "auto" (translates all text & issues automatically with zero config).
# Optional paid providers: "google" | "deepl" | "openai"
# ----------------------------------------------------------------------------
TRANSLATION_PROVIDER=auto
TRANSLATION_API_KEY=

# Time window (in minutes) during which a student can delete their own issue (default: 60 = 1 hour)
AUTHOR_DELETE_WINDOW_MINUTES=60
