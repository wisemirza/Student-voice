{
  "name": "uwe-student-voice",
  "version": "1.0.0",
  "description": "Minimal Anonymous Student Feedback Web App for UWE Bristol Data Science & AI Programme",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch-path=src src/server.js",
    "test": "node --no-warnings tests/run-tests.js && node --no-warnings tests/browser-e2e.js",
    "test:api": "node --no-warnings tests/run-tests.js",
    "test:e2e": "node --no-warnings tests/browser-e2e.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4"
  }
}
